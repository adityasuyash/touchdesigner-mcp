# TouchDesigner
*.toe
*.toe.dir/
# ...except the bootstrap template, kept in its expanded text form so the repo
# stays diffable and nothing binary is committed. `toecollapse` rebuilds it into
# a .toe during setup, and needs both the .dir and the .toc.
!templates/**
Backup/
CrashAutoSave.*

# Videos (keep mp4s local only)
*.mp4
# ...except style previews, which are rendered from placeholder words and carry
# no song data, so they ship with the style they describe.
!styles/**/preview.mp4

# macOS
.DS_Store

# Claude Code local state (keep .claude/skills/ tracked)
.claude/settings.local.json
.claude/projects/

# lyricfield working data
# Cue tables hold user-supplied lyric text and config holds local paths, so
# neither belongs in a shared repo. Examples are tracked instead.
data/cues.tsv
data/config.toml
data/stills/
data/*.raw

# Python
__pycache__/
*.pyc
.venv/
venv/

# Style previews are now rendered from placeholder words (data/preview_cues.tsv),
# never from the loaded song, so they carry no lyrics and are committed: made
# once, reused everywhere, rather than remade on every machine.
